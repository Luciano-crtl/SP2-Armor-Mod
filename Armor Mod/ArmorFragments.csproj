<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<AssemblyName>ArmorFragments</AssemblyName>
		<RootNamespace>ArmorFragments</RootNamespace>
		<LangVersion>latest</LangVersion>
			<!-- Symbols inside the DLL (one file to copy, nothing to forget): error lines in the log then say which line of the mod failed.
			     Build with -p:DebugType=portable to get a separate .pdb instead. -->
			<DebugType>embedded</DebugType>
		<GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\SimplePlanes 2</GameDir>
	</PropertyGroup>

	<!-- The game's data folder is named after its exe, which differs between installs
	     ("SimplePlanes 2_Data" or "SimplePlanes 2 (1.1)_Data"). Override with -p:ManagedDir=... if neither fits. -->
	<PropertyGroup>
		<ManagedDir Condition="'$(ManagedDir)' == '' And Exists('$(GameDir)\SimplePlanes 2_Data\Managed')">$(GameDir)\SimplePlanes 2_Data\Managed</ManagedDir>
		<ManagedDir Condition="'$(ManagedDir)' == '' And Exists('$(GameDir)\SimplePlanes 2 (1.1)_Data\Managed')">$(GameDir)\SimplePlanes 2 (1.1)_Data\Managed</ManagedDir>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="BepInEx">
			<HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="0Harmony">
			<HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Game">
			<HintPath>$(ManagedDir)\Game.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine">
			<HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.PhysicsModule">
			<HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.TerrainModule">
			<HintPath>$(ManagedDir)\UnityEngine.TerrainModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.TerrainPhysicsModule">
			<HintPath>$(ManagedDir)\UnityEngine.TerrainPhysicsModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<!-- The turret aim's circle and marker are drawn in OnGUI, over everything (inverting what is behind them) -->
		<Reference Include="UnityEngine.IMGUIModule">
			<HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<!-- The wheel zoom of the orbit camera (the game reads the raw wheel the same way) -->
		<Reference Include="UnityEngine.InputLegacyModule">
			<HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.ParticleSystemModule">
			<HintPath>$(ManagedDir)\UnityEngine.ParticleSystemModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Unity.RenderPipelines.Universal.Runtime">
			<HintPath>$(ManagedDir)\Unity.RenderPipelines.Universal.Runtime.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Unity.RenderPipelines.Core.Runtime">
			<HintPath>$(ManagedDir)\Unity.RenderPipelines.Core.Runtime.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.AssetBundleModule">
			<HintPath>$(ManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<!-- Fuselage section sizes (per-face armor) -->
		<Reference Include="Unity.Mathematics">
			<HintPath>$(ManagedDir)\Unity.Mathematics.dll</HintPath>
			<Private>False</Private>
		</Reference>

		<!-- Crew: the seated characters' bones -->
		<Reference Include="UnityEngine.AnimationModule">
			<HintPath>$(ManagedDir)\UnityEngine.AnimationModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<!-- Crew: engines' power (the game's vehicle physics) -->
		<Reference Include="NWH.VehiclePhysics2">
			<HintPath>$(ManagedDir)\NWH.VehiclePhysics2.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="NWH.Common">
			<HintPath>$(ManagedDir)\NWH.Common.dll</HintPath>
			<Private>False</Private>
		</Reference>

		<!-- UI panel: the game's UI library (Juicy) and what it is built on -->
		<Reference Include="Jundroo.Packages">
			<HintPath>$(ManagedDir)\Jundroo.Packages.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Jundroo.Common">
			<HintPath>$(ManagedDir)\Jundroo.Common.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.UIModule">
			<HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.UI">
			<HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Unity.TextMeshPro">
			<HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Unity.InputSystem">
			<HintPath>$(ManagedDir)\Unity.InputSystem.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="FishNet.Runtime">
			<HintPath>$(ManagedDir)\FishNet.Runtime.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>

</Project>
<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<AssemblyName>ArmorFragments</AssemblyName>
		<RootNamespace>ArmorFragments</RootNamespace>
		<LangVersion>latest</LangVersion>
		<GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\SimplePlanes 2</GameDir>
	</PropertyGroup>

	<!-- The game's data folder is named after its exe, which differs between installs
	     ("SimplePlanes 2_Data" or "SimplePlanes 2 (1.1)_Data"). Override with -p:ManagedDir=... if neither fits. -->
	<PropertyGroup>
		<ManagedDir Condition="'$(ManagedDir)' == '' And Exists('$(GameDir)\SimplePlanes 2_Data\Managed')">$(GameDir)\SimplePlanes 2_Data\Managed</ManagedDir>
		<ManagedDir Condition="'$(ManagedDir)' == '' And Exists('$(GameDir)\SimplePlanes 2 (1.1)_Data\Managed')">$(GameDir)\SimplePlanes 2 (1.1)_Data\Managed</ManagedDir>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="BepInEx">
			<HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="0Harmony">
			<HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Game">
			<HintPath>$(ManagedDir)\Game.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine">
			<HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.PhysicsModule">
			<HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
			<Private>False</Private>
		</Reference>

		<!-- UI panel: the game's UI library (Juicy) and what it is built on -->
		<Reference Include="Jundroo.Packages">
			<HintPath>$(ManagedDir)\Jundroo.Packages.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Jundroo.Common">
			<HintPath>$(ManagedDir)\Jundroo.Common.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.UIModule">
			<HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.UI">
			<HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Unity.TextMeshPro">
			<HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Unity.InputSystem">
			<HintPath>$(ManagedDir)\Unity.InputSystem.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="FishNet.Runtime">
			<HintPath>$(ManagedDir)\FishNet.Runtime.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>

</Project>